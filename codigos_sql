);

CREATE TABLE produto (
    id_produto INT IDENTITY(1,1) PRIMARY KEY,
    produto VARCHAR(100) NOT NULL,
    dt_entrega DATE NOT NULL,
    preco DECIMAL(19,2) NOT NULL,
